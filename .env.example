# Application
APP_NAME=FraudShield AI
DEBUG=true
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
DATABASE_URL=postgresql+asyncpg://fraudshield:fraudshield_secret@localhost:5432/fraudshield_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=fraudshield-api

# ML Service
ML_MODEL_PATH=./ml/models
ML_ACTIVE_MODEL_VERSION=v1

# Gemini (AI Assistant)
GEMINI_API_KEY=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_ARTIFACT_ROOT=./ml/artifacts

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Risk Thresholds
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
